# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betting_cx?schema=public"

# Port for NestJS Tool Server
PORT=3000

# Shared secret between Python ADK agent and NestJS internal tool API
INTERNAL_API_KEY="dev-internal-adk-secret-key-change-in-prod"

# Autonomous remediation ceiling in KES (above this -> HITL Approval Queue)
MAX_AUTO_REMEDIATE_AMOUNT=10000
