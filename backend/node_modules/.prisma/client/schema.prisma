generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycTier {
  TIER_1
  TIER_2
  TIER_3
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  LOCKED_FRAUD_REVIEW
}

enum BetSettlementStatus {
  PENDING
  WON
  LOST
  VOID
  MISSETTLED
}

enum WithdrawalChannel {
  MPESA
  BANK_TRANSFER
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  FAILED_NEEDS_REFUND
  REFUNDED
  LOCKED
}

enum JourneyEventType {
  LOGIN
  DEPOSIT
  WITHDRAWAL_ATTEMPT
  BET_PLACED
  DEVICE_CHANGE
  BONUS_CLAIM
}

enum EscalationReason {
  SENSITIVE_MUTATION
  HIGH_VALUE_DISPUTE
  AMBIGUOUS_EDGE_CASE
  POLICY_RESTRICTION
}

enum EscalationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EscalationStatus {
  OPEN_HITL
  ASSIGNED_LIVE_AGENT
  RESOLVED
  REJECTED
}

enum EscalationQueue {
  HITL_APPROVAL
  LIVE_SUPPORT
}

enum SecurityAlertType {
  SQL_INJECTION
  PROMPT_INJECTION
  HARASSMENT
  FRAUD_ANOMALY
  BONUS_ABUSE
}

enum AlertSeverity {
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  INVESTIGATING
  DISMISSED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  phone         String        @unique
  fullName      String
  kycTier       KycTier       @default(TIER_1)
  accountStatus AccountStatus @default(ACTIVE)
  walletBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  currency      String        @default("KES")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bets              Bet[]
  withdrawals       Withdrawal[]
  journeyLogs       CustomerJourneyLog[]
  escalationTickets EscalationTicket[]
  securityAlerts    SecurityAlert[]
  auditLogs         AuditLog[]

  @@index([email, phone])
}

model Bet {
  id                  String              @id @default(uuid())
  betSlipCode         String              @unique
  userId              String
  matchName           String
  market              String
  selection           String
  odds                Decimal             @db.Decimal(8, 2)
  stake               Decimal             @db.Decimal(12, 2)
  potentialPayout     Decimal             @db.Decimal(12, 2)
  officialMatchResult String?
  settlementStatus    BetSettlementStatus @default(PENDING)
  payoutCredited      Boolean             @default(false)
  placedAt            DateTime            @default(now())
  settledAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, settlementStatus])
}

model Withdrawal {
  id             String            @id @default(uuid())
  transactionRef String            @unique
  userId         String
  amount         Decimal           @db.Decimal(12, 2)
  channel        WithdrawalChannel @default(MPESA)
  destination    String
  status         WithdrawalStatus  @default(PENDING)
  gatewayCode    String?
  failureReason  String?
  autoRefunded   Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CustomerJourneyLog {
  id                String           @id @default(uuid())
  userId            String
  eventType         JourneyEventType
  ipAddress         String
  deviceFingerprint String
  amount            Decimal?         @db.Decimal(12, 2)
  metadata          Json?
  riskScore         Int              @default(0)
  isAnomaly         Boolean          @default(false)
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isAnomaly, createdAt])
}

model EscalationTicket {
  id                String             @id @default(uuid())
  ticketCode        String             @unique
  userId            String
  reason            EscalationReason
  priority          EscalationPriority @default(MEDIUM)
  status            EscalationStatus   @default(OPEN_HITL)
  assignedQueue     EscalationQueue    @default(LIVE_SUPPORT)
  summary           String
  diagnosticContext Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model SecurityAlert {
  id                 String            @id @default(uuid())
  userId             String?
  alertType          SecurityAlertType
  severity           AlertSeverity     @default(HIGH)
  isSilentAdminAlert Boolean           @default(false)
  payloadSnippet     String
  sourceIp           String?
  status             AlertStatus       @default(OPEN)
  createdAt          DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([alertType, status, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  actor          String
  action         String
  referenceId    String?
  amountAffected Decimal? @db.Decimal(12, 2)
  details        Json
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, action, createdAt])
}
